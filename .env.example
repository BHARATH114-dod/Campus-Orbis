# Base URL for the Express API. Leave as /api during development — the Vite
# dev server proxies it to the backend (see vite.config.js), which keeps the
# session cookie same-origin. Only change this for a production deployment
# where the React build is NOT served by the same Express app.
VITE_API_BASE_URL=/api

# ---------- Firebase Cloud Messaging (push notifications) ----------
# All of these come from Firebase Console → Project settings → General →
# "Your apps" → the web app (</> icon) → SDK setup and configuration.
# None of these are secret — see the comment in src/firebase.js for why.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# From Firebase Console → Project settings → Cloud Messaging → Web
# configuration → "Web Push certificates" → Generate key pair (if you
# don't see this section, click "Generate key pair" the first time).
VITE_FIREBASE_VAPID_KEY=

# IMPORTANT: public/firebase-messaging-sw.js can't read this .env file
# (service workers run outside Vite's build pipeline) — copy the six
# VITE_FIREBASE_* values above directly into that file too. See the
# comment at the top of that file.
